PORT=4000
DB_HOST=localhost
DB_PORT=5432
DB_USER=nube_user
DB_PASSWORD=1111
DB_NAME=nube_db
UPLOAD_DIR=./uploads

# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Poné false cuando ya hayas creado todas las cuentas
ALLOW_REGISTER=true

# HTTPS (se activa con: npm run start:https). Certificados en ../certs por defecto.
# HTTPS_PORT=4443
# HTTPS_KEY=../certs/key.pem
# HTTPS_CERT=../certs/cert.pem
